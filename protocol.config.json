{
  "schema_version": "1.0",
  "protocol_version": "1.14.0",
  "runtime_version": "0.12.0",
  "project_name": "multi_agent_project_protocol",
  "adoption_tier": "runtime",
  "source_of_truth": "AGENTS.md",
  "agent_roles": {
    "architect": "Arquitecto",
    "implementer": "Codex",
    "human_owner": "operador humano"
  },
  "quality_gates": ["validador_verde", "neutralidad_de_dominio"],
  "human_approval_points": ["cambios_incompatibles_de_protocolo", "publicacion_de_version_mayor"],
  "token_cost": {
    "chars_per_token": 4,
    "coldstart_globs": [
      "AGENTS.md",
      "Area_comun/README.md",
      "Area_comun/protocol/TASK_PROTOCOL.md",
      "Area_comun/state/PROJECT_STATE.slim.json",
      "Area_comun/state/TASK_INDEX.slim.json",
      "Area_comun/state/CLAIMS.slim.json"
    ],
    "budget": 30000
  },
  "maintenance": {
    "enabled": true,
    "cold_start_tokens_hard": 20000,
    "done_ratio_hard": 85,
    "released_ratio_hard": 90,
    "recent_done_tasks": 2,
    "recent_released_claims": 4,
    "mailbox_keep_recent": 8,
    "recent_next_actions": 8
  },
  "metrics": {
    "cost_attribution_enabled": true
  },
  "runtime": {
    "enabled": true,
    "entrypoint": "runtime/orchestrator.py",
    "real_invoker": {
      "enabled": false,
      "activation_decision": "DECISION-0027",
      "approved_by": "operador humano (Jball, john.ballestas@gmail.com)",
      "approved_at": "2026-06-08"
    },
    "llm_cli_presets": {
      "claude": {
        "command": "python runtime/llm_turn_wrapper.py --backend \"claude -p\""
      },
      "codex": {
        "command": "python runtime/llm_turn_wrapper.py --backend \"codex exec -s workspace-write -c approval_policy=never -c model_reasoning_effort=low --skip-git-repo-check\""
      }
    },
    "supervised_autonomy": {
      "enabled": false,
      "activation_decision": "DECISION-0027",
      "approved_by": "operador humano (Jball, john.ballestas@gmail.com)",
      "approved_at": "2026-06-08",
      "caps": {
        "max_turns": 2,
        "human_checkpoint_every_k": 1,
        "wall_clock_ms": 180000
      }
    },
    "team_bridge": {
      "enabled": false,
      "layers": [],
      "activation_decision": "",
      "approved_by": "",
      "approved_at": ""
    },
    "context_policy": {
      "compaction_enabled": true,
      "recent_turn_summaries": 3,
      "task_close_summary_max_tokens": 2000,
      "subagents_enabled": false,
      "subagent_summary_max_tokens": 2000,
      "assembled_context_warn_tokens": 16000,
      "consolidation_trigger": "min(time, volume, tokens)",
      "consolidation_interval_minutes": 30,
      "consolidation_tool_call_count": 10,
      "consolidation_overhead_budget_pct": 5
    }
  },
  "event_auth": {
    "enabled": true,
    "method": "hmac-sha256",
    "issuer": "local-runtime",
    "audience": "runtime-event-log",
    "keys": {
      "Arquitecto": { "key_id": "arquitecto-hmac:v1", "secret_file": "secrets/eventauth-arquitecto.key" },
      "Codex": { "key_id": "codex-hmac:v1", "secret_file": "secrets/eventauth-codex.key" },
      "runtime": { "key_id": "runtime-hmac:v1", "secret_file": "secrets/eventauth-runtime.key" }
    }
  },
  "event_state": {
    "enabled": true,
    "materialize": true,
    "enforce": true,
    "authoritative": true,
    "slim_views_enabled": true,
    "chain_enabled": true,
    "agent_signatures_enabled": true,
    "signature_backend": "local-ed25519",
    "signature_config": {
      "backend": "local-ed25519",
      "public_keys": {
        "arquitecto:v1": "d0bU3HbNAfVJcM2q1csln299CAzmSI65izWZIcohXLk=",
        "codex:v1": "2CjyIx4Tt2oGIE0UDBI9GQ8P4w3R5pjGfMrdk8KDQRU=",
        "analista:v1": "vD7vTJ9xcJtOBTEQ0hoEVqWX7yDU18JqGrqRX6JH3Qg="
      }
    },
    "anchor_enabled": true,
    "anchor_config": {
      "backend": "git-remote",
      "remote_url": "D:\\Agentes\\audit-anchor",
      "branch": "audits/default",
      "identity": "runtime-anchor",
      "interval_seconds": 3600,
      "retry_max_attempts": 3,
      "retry_backoff_seconds": 10
    }
  },
  "agent_registry": {
    "enabled": true,
    "agents": [
      { "id": "Arquitecto", "enabled": true, "capabilities": ["architect", "reviewer", "orchestrator", "qa"] },
      { "id": "Codex", "enabled": true, "capabilities": ["implementer"] },
      { "id": "Analista", "enabled": true, "capabilities": ["reviewer"] }
    ]
  },
  "pre_t0_provenance": {
    "boundary": "T0",
    "decision": "DECISION-0045",
    "declaration": "operative ledger of the thesis dataset starts at T0; pre-T0 history is sealed (preserved in git + cold export) outside the operative validation path",
    "pre_t0_last_commit": "94d2e58e2b34506d32c20ebd258245eabd0ed7db",
    "sealed_export": {
      "path": "pre_t0_ledger_seal/events-pre-t0-000001-000671.jsonl",
      "sha256": "7e2452aef71352c863f467612a4b3742446574d342c100020619055ff186fbe3",
      "seq_range": [1, 671],
      "event_count": 671
    }
  },
  "tool_policy": {
    "enabled": true,
    "default": "deny",
    "agent_policies": {
      "Claude": "policy.architect",
      "Codex": "policy.implementer"
    },
    "policies": {
      "policy.architect": {
        "allow": [
          {
            "tool": "runtime.plan",
            "capabilities": ["orchestrator"],
            "scope": ["Area_comun/", "runtime/"],
            "actions": ["read"]
          },
          {
            "tool": "mailbox.write",
            "capabilities": ["orchestrator", "reviewer"],
            "scope": ["Area_comun/mailbox/"],
            "actions": ["local_write"]
          }
        ]
      },
      "policy.implementer": {
        "allow": [
          {
            "tool": "local.shell",
            "capabilities": ["implementer", "test_engineer"],
            "scope": ["Area_comun/", "examples/", "runtime/", "scripts/", "protocol.config.json", "protocol.config.template.json", ".github/workflows/validate.yml"],
            "actions": ["read", "local_exec"]
          },
          {
            "tool": "local.patch",
            "capabilities": ["implementer"],
            "scope": ["Area_comun/", "examples/", "runtime/", "scripts/", "protocol.config.json", "protocol.config.template.json", ".github/workflows/validate.yml"],
            "actions": ["local_write"]
          }
        ]
      }
    }
  },
  "routing_epoch": "0",
  "routing_weights": {
    "active_claims": 10,
    "pending_reviews": 6,
    "pending_qa": 6,
    "open_fix_cycles": 4,
    "cooldown_penalty": 1,
    "capability_affinity": 1
  },
  "quality_policy": {
    "max_review_cycles": 3,
    "max_qa_cycles": 3,
    "escalate_to_architect_before_human": true,
    "allow_self_review": false,
    "allow_self_qa": false
  },
  "domain_neutrality": {
    "enabled": true,
    "denylist": ["trading", "spot", "binance", "backtest", "estrategia de trading"],
    "scan_globs": [
      "AGENTS.template.md",
      "Area_comun/README.template.md",
      "protocol.config.template.json",
      "Area_comun/state/*.template.json",
      "Area_comun/protocol/*.md",
      "Area_comun/protocol/HUMAN_GUIDE.template.html",
      "Area_comun/specs/*_TEMPLATE.md",
      "profiles/PROFILE_TEMPLATE/**",
      "runtime/team_bridge.py",
      "runtime/**",
      "scripts/*.py",
      "scripts/*.ps1"
    ],
    "exempt_globs": [
      "profiles/**",
      "examples/**",
      "personal/**",
      "Area_comun/decisions/**",
      "Area_comun/tasks/**",
      "Area_comun/handoffs/**",
      "Area_comun/reports/**",
      "Area_comun/artifacts/**",
      "Area_comun/mailbox/**",
      "runtime/state/**",
      "HUMAN_GUIDE.md",
      "HUMAN_GUIDE.html"
    ]
  },
  "state_invariants": [
    {
      "path": "status",
      "equals": "active",
      "description": "El proyecto del protocolo debe permanecer activo."
    }
  ]
}
