{
  "schema_version": "1.0",
  "protocol_version": "0.1.0",
  "project_name": "minimal_sdd_instance",
  "source_of_truth": "AGENTS.md",
  "agent_roles": {
    "architect": "architect_agent",
    "implementer": "implementer_agent",
    "human_owner": "human_owner"
  },
  "quality_gates": ["validator_green"],
  "human_approval_points": ["critical_boundary_change"],
  "sdd": {
    "enabled": true,
    "enforcement": "new_implementable_tasks",
    "adopted_at": "2026-06-05"
  },
  "state_invariants": [
    {
      "path": "status",
      "equals": "active",
      "description": "The example project must remain active."
    }
  ]
}
