{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multi-agent-protocol/runtime/turn_schema.json",
  "title": "Turn report",
  "description": "Contrato estricto que un agente devuelve al terminar UN turno. El orquestador lo valida, comprueba que changed_paths esta dentro del claim, aplica las transiciones, corre el gate (validador + scan de neutralidad) y, si verde, hace 1 commit; si rojo, git revert + blocked + escala. Ver SPEC-0026 y DECISION-0009.",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn_id", "task_id", "agent", "outcome", "summary", "changed_paths", "commit_message"],
  "properties": {
    "turn_id": {
      "type": "string",
      "description": "Identificador unico del turno (lo asigna el orquestador, no el agente)."
    },
    "task_id": {
      "type": "string",
      "pattern": "^(TASK-[0-9]{4}|none)$",
      "description": "Tarea sobre la que actuo el turno, o 'none' (p.ej. coordinacion de mailbox)."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Quien ejecuto el turno. La identidad y capacidades se validan semanticamente contra agent_registry/agent_roles/default."
    },
    "outcome": {
      "type": "string",
      "enum": ["ok", "in_review", "done", "blocked", "decision_required", "human_required", "no_op"],
      "description": "Resultado del turno. Determina las transiciones validas y los gates humanos."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "description": "Una linea: el delta del turno (no recapitular contexto)."
    },
    "changed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rutas escritas en el turno. INVARIANTE: cada ruta debe estar cubierta por el scope del claim activo del agente (write-allowlist). El orquestador rechaza si no."
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador de intento para idempotencia N-agente. Opcional hasta Fase 2+."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Clave de idempotencia del intent. Duplicado exacto se resuelve en el writer."
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Version esperada del aggregate/tarea; si se informa, se valida contra el event log."
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 0,
      "description": "Fencing token del claim/intento; si se informa, se valida contra el token vigente del aggregate."
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cambios de estado a aplicar. El 'from' debe casar con el estado actual (deteccion de carrera).",
      "properties": {
        "task_status": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "proposed",
                "ready",
                "claimed",
                "in_progress",
                "in_review",
                "changes_requested",
                "review_approved",
                "qa_pending",
                "qa_failed",
                "architect_review",
                "done",
                "blocked",
                "cancelled"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "proposed",
                "ready",
                "claimed",
                "in_progress",
                "in_review",
                "changes_requested",
                "review_approved",
                "qa_pending",
                "qa_failed",
                "architect_review",
                "done",
                "blocked",
                "cancelled"
              ]
            }
          }
        },
        "review_qa": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": {
              "type": "string",
              "enum": ["reject_review", "approve_review", "fail_qa", "pass_qa", "assign_fix"]
            },
            "author": { "type": "string" },
            "original_author": { "type": "string" },
            "reviewer": { "type": "string" },
            "qa": { "type": "string" },
            "attempt_id": { "type": "string" },
            "assignee": { "type": "string" },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "checks_failed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["check_id", "error_class", "artifact_path"],
                "properties": {
                  "check_id": { "type": "string", "minLength": 1 },
                  "error_class": { "type": "string", "minLength": 1 },
                  "artifact_path": { "type": "string", "minLength": 1 },
                  "log": { "type": "string" },
                  "failure_signature": { "type": "string" }
                }
              }
            },
            "requires_human_decision": { "type": "boolean" }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "claim_id"],
            "properties": {
              "op": { "type": "string", "enum": ["acquire", "release"] },
              "claim_id": { "type": "string" },
              "scope": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "mailbox": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "message_id"],
            "properties": {
              "op": { "type": "string", "enum": ["send", "answer", "archive"] },
              "message_id": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        },
        "handoff": {
          "type": ["string", "null"],
          "description": "Ruta del handoff escrito este turno, o null."
        }
      }
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "description": "Mensaje del commit del turno (1 turno = 1 commit)."
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "human_required": { "type": "boolean", "description": "true => el orquestador para el loop y escala al humano." },
        "reason": { "type": "string" }
      }
    },
    "next_hint": {
      "type": ["string", "null"],
      "description": "Pista opcional para el router; NO es vinculante (el router decide)."
    }
  },
  "allOf": [
    {
      "description": "Si outcome requiere parada humana, gate.human_required debe ser true.",
      "if": { "properties": { "outcome": { "enum": ["decision_required", "human_required"] } } },
      "then": { "properties": { "gate": { "required": ["human_required"], "properties": { "human_required": { "const": true } } } }, "required": ["gate"] }
    }
  ]
}
