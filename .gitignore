# Python
__pycache__/
*.py[cod]
*$py.class

# OS / editor cruft
.DS_Store
Thumbs.db

# Runtime execution traces (local audit; deterministic per run, regenerable)
runtime/runs/
runtime/state/.ledger.lock

# Repo-local transient temp dirs: runtime write-path staging/backups + golden test fixtures.
# Sweep legacy root-level leftovers and this parent with scripts/clean_workspace_temp.py.
.protocol-tmp/
secrets/
.protocol-secrets/

# Connector / operator credentials -- NEVER commit secrets (hard boundary, AGENTS.md s4)
*.env
personal/operador/*.env
connectors/*.runtime.json
event-state.runtime.json

# Arquitecto ephemeral scratch (local, non-shared): submit_intent input drafts, local
# timestamps, agent-skill cache, and TFM/carril-A working data (regenerable from the
# sealed tag). Not part of the protocol core; kept out of the shared tree (DECISION-0016).
.agents/
personal/Arquitecto/TX-*.json
personal/Arquitecto/.hyg_ts
personal/Arquitecto/.mbhyg_ts
personal/Arquitecto/*.out
personal/Arquitecto/carril_A/.req_baseline
personal/Arquitecto/carril_A/*.json
personal/Arquitecto/TFM-medicion/corpus/
