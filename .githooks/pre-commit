#!/usr/bin/env sh
set -u

# E6-A cost split: every local commit runs the cheap staged-snapshot checks.
# Full collaboration validation is opt-in locally with HOOK_FULL=1 or
# `git config hook.full true`; clean-clone CI remains the hard enforcement.
# This keeps the first line fast while accepting a transient red HEAD risk after
# a bounded local commit. Run the documented full gate before push to mitigate it.
# Include every content-bearing change kind. In particular, D is mandatory:
# deleting governed state or judgment code must select the full validator too.
# T is explicit as a path type change can make a judged file unusable.
# --name-only drops the source of a rename. Expand name-status instead so an
# R100 from a governed route to an ungoverned route cannot evade selection.
staged_paths=$(git diff --cached --name-status --diff-filter=ACMRTD | awk '
  $1 ~ /^[RC][0-9]+$/ { print $2; print $3; next }
  { print $2 }
')
full_validation=0
if [ "${HOOK_FULL:-0}" = "1" ]; then
  full_validation=1
elif git config --bool --get hook.full 2>/dev/null | grep -qx true; then
  full_validation=1
fi

# The bounded path intentionally avoids checkout-index: copying the whole
# repository was the dominant local cost. These cheap guards inspect the current
# tree; CI and explicit full mode provide the staged-snapshot judgment.
if [ "$full_validation" -eq 0 ]; then
  python scripts/prune_state.py --check
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "WARNING: protocol state pruning is due; local commit continues." >&2
    echo "At the next coordinated Architect checkpoint, run: python scripts/prune_state.py --root . --apply" >&2
    echo "CI remains the hard enforcement boundary for overdue pruning." >&2
  fi

  for path in $staged_paths; do
    case "$path" in
      Area_comun/protocol/HUMAN_GUIDE.template.md|Area_comun/protocol/HUMAN_GUIDE.template.html|scripts/generate_human_guide.py)
        python scripts/generate_human_guide.py --root . --in Area_comun/protocol/HUMAN_GUIDE.template.md --out Area_comun/protocol/HUMAN_GUIDE.template.html --kind template --check
        status=$?
        if [ "$status" -ne 0 ]; then
          echo "human guide template drift; run: python scripts/generate_human_guide.py --root . --in Area_comun/protocol/HUMAN_GUIDE.template.md --out Area_comun/protocol/HUMAN_GUIDE.template.html --kind template" >&2
          exit "$status"
        fi
        break
        ;;
    esac
  done
  exit 0
fi

# Materialize exactly the index bytes needed by the validator before judgment.
# Inventory derived from scripts/validate_collaboration_state.py and its runtime
# imports: collaboration data, runtime state, validator/prune scripts, profiles,
# examples, live config, and the runtime-tier CI sentinel. The total mode is a
# regression oracle; normal full mode uses the partial inventory.
snapshot_root=$(mktemp -d "${TMPDIR:-/tmp}/protocol-index.XXXXXX") || exit 1
cleanup_snapshot() {
  rm -rf -- "$snapshot_root"
}
trap cleanup_snapshot EXIT HUP INT TERM
snapshot_inventory='Area_comun
runtime
scripts
profiles
examples
protocol.config.json
protocol.config.template.json
AGENTS.md
AGENTS.template.md
CHANGELOG.md
README.md
README_INSTANCIACION.md
.gitattributes
.githooks/pre-commit
.github/workflows/validate.yml'
if [ "${HOOK_SNAPSHOT_MODE:-partial}" = "total" ]; then
  git ls-files -z | git checkout-index --stdin -z --force --prefix="$snapshot_root/"
else
  # Deliberate word splitting: every inventory entry is a pathspec without spaces.
  git ls-files -z -- $snapshot_inventory | git checkout-index --stdin -z --force --prefix="$snapshot_root/"
fi
status=$?
if [ "$status" -ne 0 ]; then
  echo "could not materialize staged snapshot; commit rejected" >&2
  exit 1
fi
git_dir=$(git rev-parse --absolute-git-dir) || exit 1
printf 'gitdir: %s\n' "$git_dir" > "$snapshot_root/.git"

(
  cd "$snapshot_root" || exit 1
  python scripts/prune_state.py --check
)
status=$?
if [ "$status" -ne 0 ]; then
  echo "WARNING: protocol state pruning is due; local commit continues." >&2
  echo "At the next coordinated Architect checkpoint, run: python scripts/prune_state.py --root . --apply" >&2
  echo "CI remains the hard enforcement boundary for overdue pruning." >&2
fi

if [ "$full_validation" -eq 1 ]; then
  # These are part of the local judgment boundary. Their staged removal or
  # rename must reject even when the old hook is still executing from worktree.
  for required in .githooks/pre-commit scripts/prune_state.py scripts/validate_collaboration_state.py runtime/protocol_replay.py; do
    if [ ! -f "$snapshot_root/$required" ]; then
      echo "required judgment file missing from staged snapshot: $required" >&2
      exit 1
    fi
  done
  (
    cd "$snapshot_root" || exit 1
    python scripts/validate_collaboration_state.py --root .
  )
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "collaboration state in staged snapshot is invalid; commit rejected" >&2
    exit "$status"
  fi
fi

# Structural limit: deleting this hook locally prevents it from running. Local
# self-deletion is therefore detected only by review; CI pins existence + SHA-256.

needs_guide_validation=0
for path in $staged_paths; do
  case "$path" in
    Area_comun/protocol/HUMAN_GUIDE.template.md|Area_comun/protocol/HUMAN_GUIDE.template.html|scripts/generate_human_guide.py)
      needs_guide_validation=1
      break
      ;;
  esac
done
if [ "$needs_guide_validation" -eq 1 ]; then
  python scripts/generate_human_guide.py --root . --in Area_comun/protocol/HUMAN_GUIDE.template.md --out Area_comun/protocol/HUMAN_GUIDE.template.html --kind template --check
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "human guide template drift; run: python scripts/generate_human_guide.py --root . --in Area_comun/protocol/HUMAN_GUIDE.template.md --out Area_comun/protocol/HUMAN_GUIDE.template.html --kind template" >&2
    exit "$status"
  fi
fi
exit 0
